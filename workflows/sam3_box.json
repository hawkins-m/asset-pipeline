{
  "1": {"class_type": "LoadImage", "_meta": {"title": "Image to segment"},
        "inputs": {"image": ""}},
  "2": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "SAM 3.1"},
        "inputs": {"ckpt_name": "sam3.1_multiplex_fp16.safetensors"}},
  "3": {"class_type": "CLIPTextEncode", "_meta": {"title": "What to find (noun phrase)"},
        "inputs": {"text": "building", "clip": ["2", 1]}},
  "7": {"class_type": "PrimitiveBoundingBox", "_meta": {"title": "Box prompt (pixels)"},
        "inputs": {"x": 0, "y": 0, "width": 512, "height": 512}},
  "4": {"class_type": "SAM3_Detect", "_meta": {"title": "Detect + segment inside the box"},
        "inputs": {"model": ["2", 0], "image": ["1", 0], "conditioning": ["3", 0], "bboxes": ["7", 0],
                   "threshold": 0.3, "refine_iterations": 2, "individual_masks": true}},
  "5": {"class_type": "MaskToImage", "_meta": {"title": "Masks as images"},
        "inputs": {"mask": ["4", 0]}},
  "6": {"class_type": "PreviewImage", "_meta": {"title": "One mask image per object (temp)"},
        "inputs": {"images": ["5", 0]}}
}
