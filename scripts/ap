#!/usr/bin/env bash
# ap ...  -- asset pipeline CLI (stages 0-4). See USAGE.md. Runs from any directory.
# AP_ROOT is where projects/outputs live; the venv location is independent of it.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ap_root.sh"
exec "${AP_VENV:-/mnt/storage/asset-pipeline/envs/orchestrator}/bin/ap" "$@"
