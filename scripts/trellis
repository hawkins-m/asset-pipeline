#!/usr/bin/env bash
# trellis IMAGE [options]  -- image -> textured GLB with TRELLIS.2. See USAGE.md.
#
# IMAGE is a path, or a bare filename looked up in $AP_ROOT/inputs/.
# Options pass through to scripts/trellis2_image_to_glb.py (--seed, --texture-size, ...).
# GPU: TRELLIS_GPU (default 0; both ComfyUI instances run on GPU 1).
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
source "$REPO/scripts/rocm_build_env.sh"

if [ $# -lt 1 ] || [ "$1" = -h ] || [ "$1" = --help ]; then
  sed -n 2,6p "$0" | sed 's/^# \{0,1\}//'
  exit 1
fi

img="$1"; shift
if [ ! -f "$img" ] && [ -f "$AP_ROOT/inputs/$img" ]; then
  img="$AP_ROOT/inputs/$img"
fi
[ -f "$img" ] || { echo "trellis: no such image: $img (also looked in $AP_ROOT/inputs/)" >&2; exit 1; }

gpu="${TRELLIS_GPU:-0}"
if [ "$gpu" = 1 ] && ss -ltn 2>/dev/null | grep -q -E ':(8188|8189) '; then
  echo "trellis: note: ComfyUI is running on GPU 1 too." >&2
fi

HIP_VISIBLE_DEVICES="$gpu" PYTHONPATH="$AP_ROOT/src/TRELLIS.2" \
  "$AP_ROOT/envs/trellis2/bin/python" "$REPO/scripts/trellis2_image_to_glb.py" "$(readlink -f "$img")" "$@"
